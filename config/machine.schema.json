{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Database",
	"description": "packages.db in an instance file. May be overridden in config.local.json, the setup writes there.",
	"type": "object",
	"required": ["connections"],
	"properties": {
		"connections": {
			"title": "Connections",
			"description": "main is the database of the project. Any other is opened when it is first used, and a failure there does not take the site down.",
			"type": "object",
			"required": ["main"],
			"propertyNames": { "pattern": "^[a-z][a-zA-Z0-9]*$" },
			"additionalProperties": {
				"title": "Connection",
				"type": "object",
				"required": ["name"],
				"properties": {
					"driver": { "title": "Engine", "type": "string", "enum": ["mysql", "pgsql"], "default": "mysql", "x-overridable": true },
					"host": { "title": "Host", "type": "string", "default": "localhost", "x-overridable": true },
					"port": { "title": "Port", "type": "integer", "minimum": 1, "maximum": 65535, "x-overridable": true },
					"name": { "title": "Database", "type": "string", "x-overridable": true },
					"user": { "title": "User", "type": "string", "default": "root", "x-overridable": true },
					"charset": { "title": "Charset", "description": "mysql only", "type": "string", "default": "utf8" }
				}
			}
		},
		"bindOnlyUsedParams": {
			"title": "Bind only used parameters",
			"description": "Depends on the PHP version.",
			"type": "boolean",
			"x-computed": true
		}
	}
}
